  "keyFeatures": [
    "Interactive map with healthcare facility locations",
    "Appointment booking and management system",
    "User reviews and ratings for establishments",
    "Offline mode with tile precaching",
    "Multi-language support (Spanish, English, French)",
    "AI-powered chatbot with Gemini integration",
    "Emergency services widget",
    "Insurance information management",
    "Analytics dashboard for establishments",
    "JWT-based authentication"
  ],
  "publicApiSurface": [
    "POST /api/auth/login - User authentication",
    "POST /api/auth/register - User registration",
    "GET /api/establecimientos - List healthcare establishments",
    "GET /api/establecimientos/:id - Get establishment details",
    "POST /api/turnos - Create appointment",
    "GET /api/turnos/usuario/:id - Get user appointments",
    "POST /api/resenias - Create review",
    "GET /api/resenias/establecimiento/:id - Get establishment reviews",
    "GET /api/especialidades - List medical specialties",
    "GET /api/places/nearby - Search nearby places",
    "POST /api/chatbot/send-message - Chat with AI assistant"
  ]
